{
  "name": "baton-ai",
  "version": "0.1.0",
  "description": "Subscription-native multi-agent orchestrator: runs the official Claude Code, Codex and Gemini CLIs, and passes the baton with full context when one hits its usage limit.",
  "keywords": [
    "cli",
    "ai",
    "agents",
    "claude-code",
    "codex",
    "gemini",
    "orchestrator",
    "rate-limit",
    "failover"
  ],
  "license": "MIT",
  "author": "Ayoub Benderdouch",
  "homepage": "https://github.com/Ayoubbenderdouch/baton#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayoubbenderdouch/baton.git"
  },
  "bugs": {
    "url": "https://github.com/Ayoubbenderdouch/baton/issues"
  },
  "type": "module",
  "bin": {
    "baton": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
