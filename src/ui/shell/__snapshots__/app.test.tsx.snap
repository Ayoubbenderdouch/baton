// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ascii profile > renders the same screen with safe glyphs 1`] = `
"
| baton  v0.1.0                                                                    ~/projects/my-app

+--------------------------------------------------------------------------------------------------+
| > describe a task...                                                                             |
+--------------------------------------------------------------------------------------------------+

claude * ready    codex * ready    gemini * ready
enter run - tab agent - ctrl+s status - ctrl+d doctor - esc quit"
`;

exports[`idle screen > matches the target layout 1`] = `
"
▌ baton  v0.1.0                                                                    ~/projects/my-app

╭──────────────────────────────────────────────────────────────────────────────────────────────────╮
│ ❯ describe a task…                                                                               │
╰──────────────────────────────────────────────────────────────────────────────────────────────────╯

claude ● ready    codex ● ready    gemini ● ready
enter run · tab agent · ctrl+s status · ctrl+d doctor · esc quit"
`;
